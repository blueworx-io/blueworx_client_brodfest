{
  "name": "blueworx-client-brodfest",
  "version": "0.8.1",
  "private": true,
  "description": "The Brodfest website as a self-contained WordPress plugin.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "build:zip": "node scripts/build-zip.mjs",
    "lint": "eslint assets/js/src",
    "test": "playwright test --reporter=list,json",
    "wp:up": "node ../bluegroup_core_foundation/scripts/wp-test-env.mjs up --theme ../blueworx_labs_wordpress_theme --theme-slug blueworx-labs-wordpress-theme --plugin .",
    "wp:down": "node ../bluegroup_core_foundation/scripts/wp-test-env.mjs down"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "^4",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "globals": "^15.0.0",
    "tailwindcss": "^4"
  }
}
