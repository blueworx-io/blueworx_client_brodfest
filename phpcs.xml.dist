<?xml version="1.0"?>
<ruleset name="Brodfest">
	<description>WordPress coding standards for the Brodfest plugin.</description>

	<file>.</file>

	<arg name="extensions" value="php"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/plugin-update-checker/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.wp-test/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/assets/js/*</exclude-pattern>
	<!-- The shared admin design system is copied here verbatim and CI checks it
	     byte-for-byte against the foundation, so it cannot be edited to satisfy
	     this ruleset. Lint it in the foundation, not in every plugin. -->
	<exclude-pattern>*/.claude/*</exclude-pattern>
	<exclude-pattern>*/assets/blueworx-admin-design.php</exclude-pattern>
	<exclude-pattern>*/blueworx-page-editor/*</exclude-pattern>

	<rule ref="WordPress"/>

	<config name="testVersion" value="8.1-"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="blueworx-client-brodfest"/>
		</properties>
	</rule>
</ruleset>
