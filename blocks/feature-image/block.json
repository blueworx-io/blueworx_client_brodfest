{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brodfest/feature-image",
	"title": "Feature image",
	"category": "brodfest",
	"icon": "format-image",
	"description": "A large picture with its alt text. Until a picture is chosen, the box shows its placeholder label.",
	"keywords": [
		"feature",
		"image",
		"photo"
	],
	"textdomain": "blueworx-client-brodfest",
	"attributes": {
		"image": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "integer",
			"default": 0
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"imageDecorative": {
			"type": "boolean",
			"default": false
		},
		"placeholderLabel": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"customClassName": false,
		"customCSS": false
	},
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
