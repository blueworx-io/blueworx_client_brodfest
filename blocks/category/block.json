{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brodfest/category",
	"title": "Recommendations section",
	"category": "brodfest",
	"icon": "star-filled",
	"description": "A group of recommendations (beach clubs, restaurants…): its name and a row of places that swipes on a phone.",
	"keywords": [
		"recommendations",
		"places",
		"beach",
		"restaurants"
	],
	"textdomain": "blueworx-client-brodfest",
	"attributes": {
		"name": {
			"type": "string",
			"default": ""
		},
		"headingLevel": {
			"type": "integer",
			"default": 2
		},
		"bookLabel": {
			"type": "string",
			"default": ""
		},
		"places": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"customClassName": false,
		"customCSS": false
	},
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
