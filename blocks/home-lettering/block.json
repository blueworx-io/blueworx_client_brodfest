{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brodfest/home-lettering",
	"title": "Home date and lettering",
	"category": "brodfest",
	"icon": "calendar-alt",
	"description": "The date, the lettering under it, the Add to Calendar button and the line below.",
	"keywords": [
		"home",
		"date",
		"lettering",
		"save the date",
		"invitation"
	],
	"textdomain": "blueworx-client-brodfest",
	"attributes": {
		"artwork": {
			"type": "string",
			"enum": [
				"save-the-date",
				"invitation"
			],
			"default": "save-the-date"
		},
		"letteringLabel": {
			"type": "string",
			"default": ""
		},
		"note": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"customClassName": false,
		"customCSS": false,
		"inserter": true
	},
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
