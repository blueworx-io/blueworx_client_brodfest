{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brodfest/rsvp-form",
	"title": "RSVP form",
	"category": "brodfest",
	"icon": "feedback",
	"description": "The RSVP form. Replies are saved as guests, and the guest list can be downloaded from the Users screen.",
	"keywords": [
		"rsvp",
		"form",
		"guests"
	],
	"textdomain": "blueworx-client-brodfest",
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"thanks": {
			"type": "string",
			"default": ""
		},
		"closeLabel": {
			"type": "string",
			"default": ""
		},
		"attendingQuestion": {
			"type": "string",
			"default": ""
		},
		"partnerQuestion": {
			"type": "string",
			"default": ""
		},
		"accessibilityLabel": {
			"type": "string",
			"default": ""
		},
		"formNote": {
			"type": "string",
			"default": ""
		},
		"sendLabel": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"customClassName": false,
		"customCSS": false
	},
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
