{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brodfest/area",
	"title": "Area section",
	"category": "brodfest",
	"icon": "location",
	"description": "One area to stay in: its name, how far away it is, a banner picture, an introduction and the hotels, in a row that swipes on a phone.",
	"keywords": [
		"area",
		"hotels",
		"accommodation",
		"stay"
	],
	"textdomain": "blueworx-client-brodfest",
	"attributes": {
		"name": {
			"type": "string",
			"default": ""
		},
		"headingLevel": {
			"type": "integer",
			"default": 2
		},
		"distance": {
			"type": "string",
			"default": ""
		},
		"image": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "integer",
			"default": 0
		},
		"imagePhone": {
			"type": "string",
			"default": ""
		},
		"imagePhoneId": {
			"type": "integer",
			"default": 0
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"imageDecorative": {
			"type": "boolean",
			"default": false
		},
		"imageLabel": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"quoteCode": {
			"type": "string",
			"default": ""
		},
		"bookLabel": {
			"type": "string",
			"default": ""
		},
		"hotels": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"customClassName": false,
		"customCSS": false
	},
	"editorScript": "file:./edit.js",
	"render": "file:./render.php"
}
